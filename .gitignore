</div>

<div style="text-align:center;margin-top:30px;">
<button onclick="downloadPDF()">⬇ Download as PDF</button>
</div>

<div class="footer">
Stay consistent. Discipline > Motivation.
</div>

</div>

<script>
function downloadPDF(){
    const element=document.getElementById("studyPlan");
    html2pdf().from(element).save("Master_Study_Plan.pdf");
}
</script>

</body>
</html>
